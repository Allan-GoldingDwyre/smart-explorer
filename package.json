{
  "name": "smart-explorer",
  "displayName": "Smart Explorer",
  "description": "A smarter file explorer panel for VS Code",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allan-GoldingDwyre/smart-explorer.git"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smart-explorer",
          "title": "Smart Explorer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "smart-explorer": [
        {
          "id": "smartExplorerView",
          "name": "Smart Explorer",
          "contextualTitle": "Smart Explorer"
        },
        {
          "id": "smartExplorerOthers",
          "name": "Autres workspaces",
          "when": "smartExplorer.hasOthers",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "smartExplorerView",
        "contents": "Aucun workspace pour ce projet.\n\nDemande à ton agent (serveur MCP Smart Explorer) de créer un workspace pour une issue ou une PR : create_workspace puis build_tree."
      }
    ],
    "commands": [
      {
        "command": "smartExplorer.refresh",
        "title": "Smart Explorer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "smartExplorer.renameWorkspace",
        "title": "Smart Explorer: Rename Workspace",
        "icon": "$(edit)"
      },
      {
        "command": "smartExplorer.deleteWorkspace",
        "title": "Smart Explorer: Delete Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "smartExplorer.addInstruction",
        "title": "Smart Explorer: Add Instruction",
        "icon": "$(comment-add)"
      },
      {
        "command": "smartExplorer.revealInExplorer",
        "title": "Smart Explorer: Reveal in Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "smartExplorer.cleanOrphans",
        "title": "Smart Explorer: Clean Orphaned Data"
      },
      {
        "command": "smartExplorer.activateWorkspace",
        "title": "Smart Explorer: Make Workspace Active",
        "icon": "$(arrow-up)"
      },
      {
        "command": "smartExplorer.followingAgent",
        "title": "Smart Explorer: Go to the agent's position",
        "icon": "$(eye)"
      },
      {
        "command": "smartExplorer.stopFollowing",
        "title": "Smart Explorer: Stop following agent",
        "icon": "$(close)"
      },
      {
        "command": "smartExplorer.followAgent",
        "title": "Smart Explorer: Follow agent (resume)"
      },
      {
        "command": "smartExplorer.walkthroughNext",
        "title": "Continuer la visite",
        "icon": "$(arrow-right)"
      },
      {
        "command": "smartExplorer.walkthroughBack",
        "title": "Étape précédente",
        "icon": "$(arrow-left)"
      },
      {
        "command": "smartExplorer.walkthroughReply",
        "title": "Répondre"
      },
      {
        "command": "smartExplorer.walkthroughSync",
        "title": "Smart Explorer: Reload walkthrough"
      }
    ],
    "keybindings": [
      {
        "command": "smartExplorer.renameWorkspace",
        "key": "f2",
        "mac": "enter",
        "when": "view == smartExplorerView && focusedView == smartExplorerView && viewItem =~ /^workspace-/ && !inputFocus"
      },
      {
        "command": "smartExplorer.walkthroughNext",
        "key": "ctrl+alt+right",
        "when": "smartExplorer.walkthrough"
      },
      {
        "command": "smartExplorer.walkthroughBack",
        "key": "ctrl+alt+left",
        "when": "smartExplorer.walkthrough"
      },
      {
        "command": "smartExplorer.stopFollowing",
        "key": "ctrl+alt+backspace",
        "when": "smartExplorer.following"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "smartExplorer.stopFollowing",
          "when": "view == smartExplorerView && smartExplorer.following",
          "group": "navigation@0"
        },
        {
          "command": "smartExplorer.refresh",
          "when": "view == smartExplorerView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "smartExplorer.stopFollowing",
          "when": "view == smartExplorerView && viewItem == following",
          "group": "inline@1"
        },
        {
          "command": "smartExplorer.activateWorkspace",
          "when": "view == smartExplorerOthers && viewItem =~ /^workspace-/",
          "group": "inline@0"
        },
        {
          "command": "smartExplorer.revealInExplorer",
          "when": "view =~ /^smartExplorer(View|Others)$/ && viewItem == file",
          "group": "inline"
        },
        {
          "command": "smartExplorer.deleteWorkspace",
          "when": "view =~ /^smartExplorer(View|Others)$/ && viewItem =~ /^workspace-/",
          "group": "inline@1"
        },
        {
          "command": "smartExplorer.renameWorkspace",
          "when": "view =~ /^smartExplorer(View|Others)$/ && viewItem =~ /^workspace-/",
          "group": "1_actions@1"
        },
        {
          "command": "smartExplorer.addInstruction",
          "when": "view =~ /^smartExplorer(View|Others)$/ && viewItem =~ /^workspace-/",
          "group": "1_actions@2"
        },
        {
          "command": "smartExplorer.deleteWorkspace",
          "when": "view =~ /^smartExplorer(View|Others)$/ && viewItem =~ /^workspace-/",
          "group": "2_danger@1"
        },
        {
          "command": "smartExplorer.stopFollowing",
          "when": "view == smartExplorerView && viewItem == following",
          "group": "1_following"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "smartExplorer.walkthroughBack",
          "group": "navigation@1",
          "when": "commentController == smartExplorer"
        },
        {
          "command": "smartExplorer.walkthroughNext",
          "group": "navigation@2",
          "when": "commentController == smartExplorer"
        },
        {
          "command": "smartExplorer.stopFollowing",
          "group": "navigation@3",
          "when": "commentController == smartExplorer"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "smartExplorer.walkthroughReply",
          "group": "inline@1",
          "when": "commentController == smartExplorer"
        },
        {
          "command": "smartExplorer.walkthroughNext",
          "group": "inline@2",
          "when": "commentController == smartExplorer"
        }
      ],
      "commandPalette": [
        {
          "command": "smartExplorer.walkthroughReply",
          "when": "false"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "smartExplorer.mcp",
        "label": "Smart Explorer"
      }
    ],
    "configuration": {
      "title": "Smart Explorer",
      "properties": {
        "smartExplorer.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Sélectionne dans l'arbre Smart Explorer le fichier ouvert dans l'éditeur (s'il fait partie du workspace mis en avant)."
        },
        "smartExplorer.walkthrough.display": {
          "type": "string",
          "enum": [
            "vscode",
            "cli"
          ],
          "enumDescriptions": [
            "Tout dans VS Code : explications en fils de commentaire, réponses dans le fil.",
            "Focus et sélection dans VS Code ; explications dans le CLI, tu écris « go » pour continuer ou ta question."
          ],
          "default": "vscode",
          "description": "Où se déroule la visite guidée : entièrement dans VS Code, ou focus/sélection dans VS Code avec les explications dans le CLI."
        },
        "smartExplorer.walkthrough.commentPosition": {
          "type": "string",
          "enum": [
            "below",
            "above"
          ],
          "default": "below",
          "description": "Où afficher l'explication d'une étape de la visite guidée : sous le code visé (défaut) ou juste au-dessus."
        }
      }
    },
    "colors": [
      {
        "id": "smartExplorer.agentHighlightBackground",
        "description": "Surlignage de la plage mise en avant par l'agent (Smart Explorer).",
        "defaults": {
          "dark": "#3794ff30",
          "light": "#0066bf20",
          "highContrast": "#3794ff60",
          "highContrastLight": "#0066bf40"
        }
      },
      {
        "id": "smartExplorer.agentActive",
        "description": "Couleur de la visite en cours (ligne « Following agent » et fichier de l'agent dans l'arbre).",
        "defaults": {
          "dark": "#ff9d2e",
          "light": "#c25a00",
          "highContrast": "#ff9d2e",
          "highContrastLight": "#c25a00"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle && npm run build:mcp",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js",
    "compile:test": "tsc -p tsconfig.test.json",
    "test": "npm run compile && npm run compile:test && npm run build:mcp && node --test out-test/test/",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "build:mcp": "esbuild src/mcpStdio.ts --bundle --platform=node --target=node18 --outfile=dist/smart-explorer-mcp.js && chmod +x dist/smart-explorer-mcp.js"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
