{
  "name": "smart-explorer",
  "displayName": "Smart Explorer",
  "description": "A smarter file explorer panel for VS Code",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allan-GoldingDwyre/smart-explorer.git"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smart-explorer",
          "title": "Smart Explorer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "smart-explorer": [
        {
          "id": "smartExplorerView",
          "name": "Smart Explorer",
          "contextualTitle": "Smart Explorer"
        },
        {
          "id": "smartExplorerOthers",
          "name": "Autres workspaces",
          "when": "smartExplorer.hasOthers",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "smartExplorerView",
        "contents": "Aucun workspace pour ce projet.\n\nDemande à ton agent (serveur MCP Smart Explorer) de créer un workspace pour une issue ou une PR : create_workspace puis set_files."
      }
    ],
    "commands": [
      {
        "command": "smartExplorer.refresh",
        "title": "Smart Explorer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "smartExplorer.renameWorkspace",
        "title": "Smart Explorer: Rename Workspace",
        "icon": "$(edit)"
      },
      {
        "command": "smartExplorer.deleteWorkspace",
        "title": "Smart Explorer: Delete Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "smartExplorer.revealInExplorer",
        "title": "Smart Explorer: Reveal in Explorer",
        "icon": "$(go-to-file)"
      },
      {
        "command": "smartExplorer.cleanOrphans",
        "title": "Smart Explorer: Clean Orphaned Data"
      },
      {
        "command": "smartExplorer.activateWorkspace",
        "title": "Smart Explorer: Make Workspace Active",
        "icon": "$(arrow-up)"
      },
      {
        "command": "smartExplorer.openWalkthrough",
        "title": "Smart Explorer: Open Walkthrough",
        "icon": "$(book)"
      }
    ],
    "keybindings": [
      {
        "command": "smartExplorer.renameWorkspace",
        "key": "f2",
        "mac": "enter",
        "when": "view == smartExplorerView && focusedView == smartExplorerView && viewItem =~ /^workspace-/ && !inputFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "smartExplorer.openWalkthrough",
          "when": "view == smartExplorerView && smartExplorer.hasWalkthrough",
          "group": "navigation@0"
        },
        {
          "command": "smartExplorer.refresh",
          "when": "view == smartExplorerView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "smartExplorer.activateWorkspace",
          "when": "view == smartExplorerOthers && viewItem =~ /^workspace-/",
          "group": "inline@0"
        },
        {
          "command": "smartExplorer.revealInExplorer",
          "when": "view =~ /^smartExplorer(View|Others)$/ && viewItem == file",
          "group": "inline"
        },
        {
          "command": "smartExplorer.deleteWorkspace",
          "when": "view =~ /^smartExplorer(View|Others)$/ && viewItem =~ /^workspace-/",
          "group": "inline@1"
        },
        {
          "command": "smartExplorer.renameWorkspace",
          "when": "view =~ /^smartExplorer(View|Others)$/ && viewItem =~ /^workspace-/",
          "group": "1_actions@1"
        },
        {
          "command": "smartExplorer.deleteWorkspace",
          "when": "view =~ /^smartExplorer(View|Others)$/ && viewItem =~ /^workspace-/",
          "group": "2_danger@1"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "smartExplorer.mcp",
        "label": "Smart Explorer"
      }
    ],
    "configuration": {
      "title": "Smart Explorer",
      "properties": {
        "smartExplorer.followActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Sélectionne dans l'arbre Smart Explorer le fichier ouvert dans l'éditeur (s'il fait partie du workspace mis en avant)."
        },
        "smartExplorer.walkthrough.preset": {
          "type": "string",
          "enum": [
            "vscode",
            "notion"
          ],
          "enumDescriptions": [
            "Couleurs et polices du thème VS Code.",
            "Page façon Notion : fond clair/sombre, typographie sans-serif, colonne étroite, code en pastille rouge."
          ],
          "default": "notion",
          "description": "Look de la visite guidée. Les réglages ci-dessous restent prioritaires sur le preset."
        },
        "smartExplorer.walkthrough.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Police du texte de la visite guidée (vide : celle de VS Code). Ex. : Georgia, serif."
        },
        "smartExplorer.walkthrough.fontSize": {
          "type": "string",
          "default": "",
          "description": "Taille du texte de la visite guidée (vide : celle de VS Code). Ex. : 16px."
        },
        "smartExplorer.walkthrough.codeFontFamily": {
          "type": "string",
          "default": "",
          "description": "Police des extraits de code (vide : celle de l'éditeur). Ex. : 'Fira Code', monospace."
        },
        "smartExplorer.walkthrough.codeFontSize": {
          "type": "string",
          "default": "",
          "description": "Taille des extraits de code (vide : celle de l'éditeur). Ex. : 13px."
        },
        "smartExplorer.walkthrough.maxWidth": {
          "type": "string",
          "default": "",
          "description": "Largeur maximale de la page (vide : 960px). Ex. : 1200px ou 100%."
        },
        "smartExplorer.walkthrough.accentColor": {
          "type": "string",
          "default": "",
          "description": "Couleur des liens, des numéros d'étape et du survol (vide : celle du thème). Ex. : #e5a50a."
        },
        "smartExplorer.walkthrough.codeBackground": {
          "type": "string",
          "default": "",
          "description": "Fond des extraits de code (vide : celui de l'éditeur). Ex. : #1a1b26."
        }
      }
    },
    "colors": [
      {
        "id": "smartExplorer.agentHighlightBackground",
        "description": "Surlignage de la plage mise en avant par l'agent (Smart Explorer).",
        "defaults": {
          "dark": "#3794ff30",
          "light": "#0066bf20",
          "highContrast": "#3794ff60",
          "highContrastLight": "#0066bf40"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle && npm run build:mcp",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --outfile=dist/extension.js",
    "compile:test": "tsc -p tsconfig.test.json",
    "test": "npm run compile && npm run compile:test && npm run build:mcp && node --test out-test/test/",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "build:mcp": "esbuild src/mcpStdio.ts --bundle --platform=node --target=node18 --outfile=dist/smart-explorer-mcp.js && chmod +x dist/smart-explorer-mcp.js"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.55.0",
    "highlight.js": "^11.12.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
