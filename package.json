{
  "name": "smart-explorer",
  "displayName": "Smart Explorer",
  "description": "A smarter file explorer panel for VS Code",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allan-GoldingDwyre/smart-explorer.git"
  },
  "bin": {
    "smart-explorer-mcp": "./out/mcpStdio.js"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smart-explorer",
          "title": "Smart Explorer",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "smart-explorer": [
        {
          "id": "smartExplorerView",
          "name": "Smart Explorer",
          "contextualTitle": "Smart Explorer"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "smartExplorerView",
        "contents": "No workspace in this project yet.\n\n[Add Workspace](command:smartExplorer.addWorkspace)"
      }
    ],
    "commands": [
      {
        "command": "smartExplorer.addWorkspace",
        "title": "Add Workspace",
        "icon": "$(add)"
      },
      {
        "command": "smartExplorer.setupLinear",
        "title": "Smart Explorer: Setup Linear API Key"
      },
      {
        "command": "smartExplorer.logoutLinear",
        "title": "Smart Explorer: Logout from Linear"
      },
      {
        "command": "smartExplorer.renameWorkspace",
        "title": "Smart Explorer: Rename Workspace",
        "icon": "$(edit)"
      },
      {
        "command": "smartExplorer.deleteWorkspace",
        "title": "Smart Explorer: Delete Workspace",
        "icon": "$(trash)"
      },
      {
        "command": "smartExplorer.addInstruction",
        "title": "Smart Explorer: Add Instruction",
        "icon": "$(comment-add)"
      },
      {
        "command": "smartExplorer.refreshWorkspace",
        "title": "Smart Explorer: Refresh Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "smartExplorer.revealInExplorer",
        "title": "Smart Explorer: Reveal in Explorer",
        "icon": "$(go-to-file)"
      }
    ],
    "keybindings": [
      {
        "command": "smartExplorer.renameWorkspace",
        "key": "f2",
        "mac": "enter",
        "when": "view == smartExplorerView && focusedView == smartExplorerView && viewItem =~ /^workspace-/ && !inputFocus"
      }
    ],
    "configuration": {
      "title": "Smart Explorer",
      "properties": {
        "smartExplorer.configureLinearKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "[Configurer la clé API Linear](command:smartExplorer.setupLinear)\n\nClique sur le lien ci-dessus : une boîte de dialogue sécurisée s'ouvre et la clé est stockée **chiffrée** (SecretStorage). Ne saisis jamais ta clé dans ce champ — elle ne doit pas être écrite en clair dans les settings.",
          "order": 1
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "smartExplorer.addWorkspace",
          "when": "view == smartExplorerView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "smartExplorer.revealInExplorer",
          "when": "view == smartExplorerView && viewItem == file",
          "group": "inline"
        },
        {
          "command": "smartExplorer.refreshWorkspace",
          "when": "view == smartExplorerView && viewItem =~ /^workspace-/",
          "group": "inline"
        },
        {
          "command": "smartExplorer.renameWorkspace",
          "when": "view == smartExplorerView && viewItem =~ /^workspace-/",
          "group": "1_actions@1"
        },
        {
          "command": "smartExplorer.addInstruction",
          "when": "view == smartExplorerView && viewItem =~ /^workspace-/",
          "group": "1_actions@2"
        },
        {
          "command": "smartExplorer.deleteWorkspace",
          "when": "view == smartExplorerView && viewItem =~ /^workspace-/",
          "group": "2_danger@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "compile:test": "tsc -p tsconfig.test.json",
    "test": "npm run compile:test && node --test out-test/test/",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "build:mcp": "esbuild src/mcpStdio.ts --bundle --platform=node --target=node18 --outfile=dist/smart-explorer-mcp.js && chmod +x dist/smart-explorer-mcp.js",
    "package": "npm run compile && npx vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
